RUNO_HOME=/var/lib/runo-ohio
RUNO_AWS_REGION=us-east-2
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2
RUNO_EXPECTED_AWS_ARN=arn:aws:iam::611816806956:user/kodus-devops-agent
RUNO_EXPECTED_AWS_REGION=us-east-2
RUNO_MAX_INSTANCES=5
RUNO_SERVER_HOST=127.0.0.1
RUNO_SERVER_PORT=7777
RUNO_SERVER_ADMINS=preview-ci
# Resolve an Ubuntu 24.04 amd64 AMI in Ohio using EC2 DescribeImages.
# RUNO_AWS_AMI=ami-...
# Generate separate tokens during deployment; never commit populated values.
# RUNO_SERVER_TOKENS=preview-ci:...,qa:...
# Panel login through GitHub. Create an OAuth App (GitHub → org settings →
# Developer settings → OAuth Apps) with callback <RUNO_PUBLIC_URL>/auth/github/callback.
# The server refuses to start with a client id and no allowlist.
# RUNO_PUBLIC_URL=https://runo.kodus.io
# RUNO_GITHUB_CLIENT_ID=...
# RUNO_GITHUB_CLIENT_SECRET=...
# RUNO_GITHUB_ALLOWED_ORGS=your-org
# RUNO_GITHUB_ALLOWED_USERS=
# Admins may be token identities or GitHub logins: RUNO_SERVER_ADMINS=preview-ci,your-login
